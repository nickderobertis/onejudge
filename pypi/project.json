{
  "name": "onejudge-pypi",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "//": "The `onejudge-cli` PyPI wheel: maturin wraps the `onejudge` binary per platform. See AGENTS.md here for why this definition is not beside its manifest.",
  "projectType": "application",
  "sourceRoot": "pypi",
  "tags": [
    "type:packaging",
    "lang:python"
  ],
  "implicitDependencies": [
    "onejudge"
  ],
  "targets": {
    "build": {
      "command": "just _pypi-build",
      "inputs": [
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/README.md",
        "{projectRoot}/**/*",
        "^default"
      ]
    },
    "test": {
      "command": "just _pypi-test",
      "dependsOn": [
        "build"
      ]
    },
    "lint": {
      "command": "just _py-lint pypi onejudge-pypi",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/scripts/check-project-boundaries.mjs",
        "{workspaceRoot}/scripts/check-target-commands.mjs"
      ]
    },
    "format": {
      "command": "just _py-format pypi"
    },
    "format-check": {
      "command": "just _py-format-check pypi"
    }
  }
}
