{
  "name": "workspace",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "//": "The workspace root: it owns every file no other project does (toolchain, lockfiles, justfile, docs, schemas, CI), so a change there runs the broader tier. It also owns the repository's scripts (install.sh, scripts/) and their offline bats suite (tests/), so it carries the shell targets: shfmt (format, format-check), shellcheck and actionlint (lint), the offline suite under bashcov (test). Its other targets are the repo-level ones: the aggregate Rust and shell coverage, the supply-chain audit, the MSRV build, and the root-file drift checks. It depends on the crates and the shell suites whose reports the coverage aggregate merges, and on the shell helpers its suite loads, so a change to any of them reruns it.",
  "projectType": "application",
  "tags": [
    "type:workspace",
    "lang:shell"
  ],
  "implicitDependencies": [
    "onejudge",
    "onejudge-test-doubles",
    "onejudge-e2e",
    "onejudge-cli-e2e",
    "onejudge-scripts-e2e",
    "onejudge-shell-test-support"
  ],
  "targets": {
    "format": {
      "command": "just _sh-format ."
    },
    "format-check": {
      "command": "just _sh-format-check ."
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "just check-release-targets",
          "node scripts/check-project-boundaries.mjs workspace",
          "node scripts/check-target-commands.mjs workspace",
          "just _sh-lint .",
          "just _actionlint"
        ],
        "parallel": false
      },
      "inputs": [
        "{workspaceRoot}/install.sh",
        "{workspaceRoot}/.github/workflows/release-binaries.yml",
        "{workspaceRoot}/scripts/check-release-targets.sh",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/**/project.json",
        "{workspaceRoot}/**/Cargo.toml",
        "{workspaceRoot}/scripts/check-project-boundaries.mjs",
        "{workspaceRoot}/scripts/check-target-commands.mjs",
        "{workspaceRoot}/scripts/**/*",
        "{workspaceRoot}/tests/**/*",
        "{workspaceRoot}/.github/workflows/*",
        "{workspaceRoot}/pixi.lock",
        "{workspaceRoot}/**/*.sh",
        "{workspaceRoot}/**/*.bash",
        "{workspaceRoot}/**/*.bats"
      ]
    },
    "test": {
      "command": "just _sh-test . workspace",
      "outputs": [
        "{workspaceRoot}/target/shell-coverage/workspace"
      ]
    },
    "coverage-clean": {
      "command": "just _coverage-clean",
      "cache": false
    },
    "coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "just _sh-coverage",
          "just _coverage"
        ],
        "parallel": false
      },
      "outputs": [
        "{workspaceRoot}/target/shell-coverage-merged"
      ],
      "dependsOn": [
        {
          "projects": [
            "onejudge",
            "onejudge-e2e",
            "onejudge-cli-e2e"
          ],
          "target": "test"
        },
        {
          "projects": [
            "workspace",
            "onejudge-scripts-e2e"
          ],
          "target": "test"
        }
      ]
    },
    "audit": {
      "command": "just _audit"
    },
    "msrv": {
      "command": "just _msrv"
    }
  }
}
