# The shell coverage tool, pinned with its gems by Gemfile.lock and installed by
# `just bootstrap` into the pixi environment's Ruby (pixi.toml). AGENTS.md, "Shell".
source "https://rubygems.org"

gem "bashcov", "4.0.0"
# The SimpleCov bashcov 4.0.0 was released against: 1.3 deprecates the
# `track_files` / `add_filter` interface bashcov and .simplecov configure it through.
gem "simplecov", "1.1.1"
