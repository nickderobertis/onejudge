+/// SPIKE ONLY (spikes/saphyr-diff): record every YAML document this crate
+/// parses into `$ONEJUDGE_SPIKE_CAPTURE`, keyed by content hash, with the
+/// executable and thread (libtest names it after the test) that parsed it.
+pub(crate) fn spike_capture(kind: &str, text: &str) {
+    use std::hash::{Hash, Hasher};
+    use std::io::Write;
+    let Some(dir) = std::env::var_os("ONEJUDGE_SPIKE_CAPTURE") else {
+        return;
+    };
+    let dir = std::path::PathBuf::from(dir).join(kind);
+    let _ = std::fs::create_dir_all(&dir);
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    text.hash(&mut hasher);
+    let key = format!("{:016x}", hasher.finish());
+    let _ = std::fs::write(dir.join(format!("{key}.yaml")), text);
+    let exe = std::env::current_exe()
+        .ok()
+        .and_then(|p| p.file_stem().map(|s| s.to_string_lossy().into_owned()))
+        .unwrap_or_default();
+    let thread = std::thread::current().name().unwrap_or("?").to_owned();
+    if let Ok(mut f) = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(dir.join(format!("{key}.origin")))
+    {
+        let _ = writeln!(f, "{exe}\t{thread}");
+    }
+}
